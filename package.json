{
  "name": "fieldmark",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent engineering equipment research and evidence library",
  "author": { "name": "Abraham Borg" },
  "license": "SEE LICENSE IN LICENSE.txt",
  "homepage": "https://github.com/abe-borg/fieldmark",
  "repository": { "type": "git", "url": "https://github.com/abe-borg/fieldmark.git" },
  "engines": { "node": ">=22.12" },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs && node scripts/third-party-notices.mjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "node scripts/smoke-ui.mjs",
    "check:core": "tsc --noEmit -p tsconfig.core.json",
    "licenses": "node scripts/third-party-notices.mjs",
    "icon": "node scripts/make-icon.mjs",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "package:dir": "npm run build && electron-builder --dir --win --x64"
  },
  "dependencies": {
    "parse5": "^7.3.0",
    "ipaddr.js": "^2.2.0",
    "fflate": "^0.8.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "robots-parser": "^3.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "44.7.2",
    "electron-builder": "26.17.0",
    "esbuild": "^0.28.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.13"
  },
  "build": {
    "appId": "app.fieldmark.desktop",
    "productName": "Fieldmark",
    "copyright": "Copyright © 2026 Abraham Borg. All rights reserved.",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/**/*", "!dist/THIRD-PARTY-NOTICES.txt", "!dist/Fieldmark-preview.html", "dist-electron/**/*", "package.json", "!node_modules/**/*"],
    "extraResources": [
      { "from": "LICENSE.txt", "to": "LICENSE.txt" },
      { "from": "dist/THIRD-PARTY-NOTICES.txt", "to": "THIRD-PARTY-NOTICES.txt" }
    ],
    "asar": true,
    "npmRebuild": false,
    "publish": null,
    "win": { "target": ["nsis"], "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "license": "LICENSE.txt", "artifactName": "Fieldmark-Setup-${version}.${ext}" }
  }
}
